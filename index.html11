</section>

<!-- FAQ -->
<section class="faq" id="duvidas" style="padding-top:0">
  <div class="container" style="max-width:780px">
    <div class="titulo rv"><span class="sobre">Tire suas dúvidas</span><h2>Perguntas frequentes</h2></div>
    <details class="rv"><summary>Preciso ter o nome limpo?</summary><p>Não necessariamente. Temos opções para negativados, como o crédito com garantia, mas tudo depende da análise do seu perfil.</p></details>
    <details class="rv"><summary>Quais documentos são necessários?</summary><p>No cadastro online pedimos apenas dados básicos. Depois, o consultor informa os documentos necessários para a sua modalidade, normalmente documento com foto, comprovante de renda e de residência.</p></details>
    <details class="rv"><summary>A simulação é o valor final?</summary><p>Não. É uma estimativa para você se planejar. Taxa, prazo e parcela finais são definidos após a análise de crédito.</p></details>
    <details class="rv"><summary>Enviar o cadastro garante a aprovação?</summary><p>Não. O cadastro dá início à análise do seu perfil. A aprovação e as condições dependem dessa análise.</p></details>
    <details class="rv"><summary>Como vocês entram em contato?</summary><p>Pelo telefone e e-mail informados no cadastro. Fique atento às ligações de números desconhecidos.</p></details>
  </div>
</section>

<!-- CTA FINAL -->
<section class="cta">
  <div class="container">
    <h2 class="rv">Pronto para dar o primeiro passo?</h2>
    <p class="rv d1">Faça sua simulação agora. Leva menos de 3 minutos e não tem compromisso.</p>
    <a href="#simulador" class="btn rv d2">Simular meu crédito
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</section>
</main>

<footer>
  <div class="container">
    <p><strong>AprovaCred</strong> — Crédito e Empréstimos</p>
    <p>[Razão social] • CNPJ 00.000.000/0001-00</p>
    <p>As condições, taxas e prazos estão sujeitos à análise de crédito e aprovação.</p>
    <p>© <span id="ano"></span> AprovaCred. Todos os direitos reservados.</p>
  </div>
</footer>

<!-- Barra fixa (mobile) -->
<div class="barra" id="barra">
  <span id="barraTxt">Simule seu crédito<small>Rápido e sem compromisso</small></span>
  <a href="#simulador" class="btn" id="barraBtn">Simular</a>
</div>

<script>
  // Taxa mensal usada SÓ na simulação ilustrativa (ajuste se quiser)
  const TAXA_MES = 0.0299;

  const $ = id => document.getElementById(id);
  const estado = {valor:5000, n:12, tipo:'pessoal'};
  const brl  = n => n.toLocaleString('pt-BR',{style:'currency',currency:'BRL',maximumFractionDigits:0});
  const brl2 = n => n.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});

  // Animação de contagem
  let exibido = {valor:5000, parcela:0};
  function animar(de, para, fn, ms=350){
    const ini = performance.now();
    (function passo(t){
      const k = Math.min(1,(t-ini)/ms), e = 1-Math.pow(1-k,3);
      fn(de + (para-de)*e);
      if (k<1) requestAnimationFrame(passo);
    })(ini);
  }

  function parcelaDe(v,n){
    return v * (TAXA_MES*Math.pow(1+TAXA_MES,n)) / (Math.pow(1+TAXA_MES,n)-1);
  }

  function atualizar(animado=true){
    const slider = $('valor');
    const pct = (estado.valor - slider.min) / (slider.max - slider.min) * 100;
    slider.style.setProperty('--p', pct + '%');
    const p = parcelaDe(estado.valor, estado.n);
    const rotulo = ' ' + estado.n + 'x de ';
    if (animado){
      animar(exibido.valor, estado.valor, x => $('valorOut').textContent = brl(Math.round(x/100)*100), 250);
      animar(exibido.parcela||p, p, x => $('parcelaOut').textContent = estado.n + 'x de ' + brl2(x), 350);
    } else {
      $('valorOut').textContent = brl(estado.valor);
      $('parcelaOut').textContent = estado.n + 'x de ' + brl2(p);
    }
    exibido = {valor:estado.valor, parcela:p};
    $('btnSim').href = `cadastro.html?valor=${estado.valor}&parcelas=${estado.n}&tipo=${estado.tipo}`;
    $('barraTxt').innerHTML = `${brl(estado.valor)} em ${estado.n}x<small>Parcela estimada ${brl2(p)}</small>`;
  }

  $('valor').addEventListener('input', e => {
    estado.valor = +e.target.value;
    const pct = (estado.valor - e.target.min) / (e.target.max - e.target.min) * 100;
    e.target.style.setProperty('--p', pct + '%');
    $('valorOut').textContent = brl(estado.valor);
    const p = parcelaDe(estado.valor, estado.n);
    $('parcelaOut').textContent = estado.n + 'x de ' + brl2(p);
    exibido = {valor:estado.valor, parcela:p};
    $('btnSim').href = `cadastro.html?valor=${estado.valor}&parcelas=${estado.n}&tipo=${estado.tipo}`;
    $('barraTxt').innerHTML = `${brl(estado.valor)} em ${estado.n}x<small>Parcela estimada ${brl2(p)}</small>`;
  });

  $('chips').addEventListener('click', e => {
    const c = e.target.closest('.chip'); if(!c) return;
    document.querySelectorAll('.chip').forEach(x => x.classList.toggle('on', x===c));
    estado.n = +c.dataset.n; atualizar();
  });

  function escolherTipo(tipo, rolar){
    estado.tipo = tipo;
    document.querySelectorAll('.tab').forEach(t => t.classList.toggle('on', t.dataset.tipo===tipo));
    atualizar();
    if (rolar) $('simulador').scrollIntoView({behavior:'smooth', block:'center'});
  }
  $('tabs').addEventListener('click', e => {
    const t = e.target.closest('.tab'); if(t) escolherTipo(t.dataset.tipo, false);
  });
  document.querySelectorAll('.prod').forEach(c => c.addEventListener('click', () => escolherTipo(c.dataset.tipo, true)));
  $('btnNeg').addEventListener('click', e => { e.preventDefault(); escolherTipo('negativados', true); });

  atualizar(false);
  $('ano').textContent = new Date().getFullYear();

  // Header com fundo ao rolar + barra fixa mobile
  const header = $('topo'), barra = $('barra'), sim = $('simulador');
  function aoRolar(){
    header.classList.toggle('scrolled', scrollY > 30);
    const r = sim.getBoundingClientRect();
    const simVisivel = r.top < innerHeight*0.9 && r.bottom > 0;
    barra.classList.toggle('show', scrollY > 500 && !simVisivel);
  }
  addEventListener('scroll', aoRolar, {passive:true}); aoRolar();

  // Aparecer ao rolar
  const io = new IntersectionObserver(es => es.forEach(x => { if(x.isIntersecting){ x.target.classList.add('in'); io.unobserve(x.target);} }), {threshold:.12});
  document.querySelectorAll('.rv').forEach(el => io.observe(el));
</script>
</body>
</html>
